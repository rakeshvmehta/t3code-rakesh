<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by install-launch-agent.sh, which fills in __REPO__, __HOME__ and the start hours __H0__ / __H1__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rakesh.t3code.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/rakesh/nightly-update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>__H0__</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>__H0__</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>__H1__</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>__H1__</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/t3code-rakesh/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/t3code-rakesh/launchd.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
