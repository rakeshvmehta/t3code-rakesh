{"id": "sidebar-set-full-note", "area": "sidebar", "kind": "bad", "pattern": "chat note unavailable to tools", "experience": "A chat note could only be edited through browser localStorage and the UI.", "privacy": "commit-safe", "source": {"feature": "shared sidebar organization"}, "setup": {"role": "top", "world": {"repo": "acme/app", "branch": "main"}, "mocks": {"t3_thread_note": {"threadId": "thread-acme", "note": "Blocked on staging"}}}, "prompt": "Set this chat's sidebar note to exactly 'Blocked on staging'. Use the T3 tools.", "expect": {"calls": [{"tool": "t3_thread_note", "args": {"action": "set", "note": "Blocked on staging"}}], "callsMustNot": [{"tool": "Edit"}, {"tool": "Write"}]}, "maxSteps": 5}
{"id": "sidebar-place-by-section-id", "area": "sidebar", "kind": "guard", "pattern": "section placement confused with archive or pin", "experience": "Custom sections and IDs were unavailable to agents, although pin and archive tools existed.", "privacy": "commit-safe", "source": {"feature": "shared sidebar organization"}, "setup": {"role": "top", "world": {"repo": "acme/app", "branch": "main"}, "mocks": {"t3_sections": {"collectionEnvironmentId": "env-main", "revision": 1, "sections": [{"id": "section-work", "name": "Work"}]}, "t3_thread_section": {"threadId": "thread-api", "placement": {"collectionEnvironmentId": "env-main", "sectionId": "section-work", "orderKey": "m"}, "sectionExists": true}}}, "prompt": "Move chat thread-api into the custom sidebar section named Work. Look up the section ID first. Keep the conversation.", "expect": {"calls": [{"tool": "t3_sections", "args": {"action": "list"}}, {"tool": "t3_thread_section", "args": {"action": "move", "threadId": "thread-api", "sectionId": "section-work"}}], "order": ["t3_sections", "t3_thread_section"], "callsMustNot": [{"tool": "t3_thread_delete"}, {"tool": "t3_thread_organize", "args": {"action": "archive"}}]}, "maxSteps": 6}
{"id": "sidebar-delete-section-keeps-chats", "area": "sidebar", "kind": "guard", "pattern": "delete section mistaken for delete chats", "experience": "Removing a sidebar section must only return its chats to Chats.", "privacy": "commit-safe", "source": {"feature": "shared sidebar organization"}, "setup": {"role": "top", "world": {"repo": "acme/app", "branch": "main"}, "mocks": {"t3_sections": {"collectionEnvironmentId": "env-main", "revision": 2, "sections": []}}}, "prompt": "Delete custom sidebar section section-done, keeping all its chats in Chats. Do not delete or archive conversations.", "expect": {"calls": [{"tool": "t3_sections", "args": {"action": "delete", "sectionId": "section-done"}}], "callsMustNot": [{"tool": "t3_thread_delete"}, {"tool": "t3_thread_organize", "args": {"action": "archive"}}]}, "maxSteps": 5}
